# HTTP port the Fastify server listens on
PORT=3000
# Host/interface to bind to (localhost keeps the dev API off the LAN)
HOST=localhost
# Comma-separated list of allowed CORS origins (the web dev server)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# CoinGecko Demo API key (leave empty to report upstream as not_configured)
COINGECKO_API_KEY=
# CoinGecko API base URL (overridable for local stubs in tests/smoke)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Markets cache lifetime in milliseconds (default 45000 = 45s). Exists so a
# smoke or QA run can shorten it to deterministically reach the D-41 stale-
# serve fallback without waiting out a real TTL window; leave unset in
# production.
MARKETS_TTL_MS=
# Path to the SQLite database file, relative to the api package root
DATABASE_PATH=data/app.db
# Path to the JSON log file, relative to the api package root (empty or "off" disables file logging)
LOG_FILE=logs/api.log
# pino log level
LOG_LEVEL=info
# Git commit SHA injected at build/CI time (fallback "dev" for local runs)
GIT_COMMIT=dev
# Set to "production" to mark the session cookie Secure (HTTPS only); leave
# unset for local http development
# NODE_ENV=production
